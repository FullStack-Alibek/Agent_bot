# ============================================================
#  .env.example  ->  nusxalab  .env  qilib saqlang
#  BotFather'dan olingan token: https://t.me/BotFather
# ============================================================

# --- Bot ---
BOT_TOKEN=
BOT_USERNAME=
# Operator/adminlar Telegram ID lari (vergul bilan). /myid buyrug'i bilan bilib olinadi.
ADMIN_IDS=
# Qo'llab-quvvatlash chati (ixtiyoriy, guruh id raqami manfiy bo'ladi, masalan -1001234567890)
SUPPORT_CHAT_ID=0

# --- Ma'lumotlar bazasi ---
# Dev (standart): SQLite. Production: postgresql+asyncpg://user:pass@host:5432/dbname
DATABASE_URL=
DB_ECHO=false

# --- Til / valyuta / hudud ---
DEFAULT_LANGUAGE=uz
SUPPORTED_LANGUAGES=["uz","ru"]
CURRENCY=so'm
TIMEZONE=Asia/Tashkent

# --- Savdo siyosati ---
DELIVERY_FEE=15000
FREE_DELIVERY_FROM=1000000
MIN_ORDER_AMOUNT=50000
ORDER_PREFIX=ORD

# --- Kontaktlar ---
BRAND_NAME=Distribyutsiya xizmati
SUPPORT_PHONE=+998 71 200-00-00
PICKUP_ADDRESS=Toshkent sh., Chilonzor, Bunyodkor ko'chasi 12
WORKING_HOURS=09:00-19:00

# --- Interfeys ---
CARDS_PER_PAGE=6
PRODUCTS_PER_PAGE=5
ORDERS_PER_PAGE=5
RATE_LIMIT_SECONDS=0.5

# --- Onlayn to'lov (3-bosqich; bo'sh bo'lsa faqat naqd/o'tkazma) ---
PAYME_MERCHANT_ID=
CLICK_SERVICE_ID=
CLICK_MERCHANT_ID=

# --- Fon vazifalari ---
ENABLE_DAILY_JOBS=true
LOW_STOCK_HOUR=9
